# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ─── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://instapulse.site

# ─── Google reCAPTCHA v3 ──────────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin/create
# Type: reCAPTCHA v3 | Domains: localhost, instapulse.site
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le...your_site_key
RECAPTCHA_SECRET_KEY=6Le...your_secret_key

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
